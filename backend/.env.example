# ==============================================================================
# URBAN FLOOD NOWCASTING & REAL-TIME WEATHER SYSTEM
# Environment Variables Configuration Template
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary Weather Provider: 'open_meteo' (Default & Free - No Key Required), 'weatherapi', 'openweathermap'
DEFAULT_WEATHER_PROVIDER=open_meteo

# WeatherAPI.com Key (Free tier 1M calls/mo: https://www.weatherapi.com/signup.aspx)
WEATHERAPI_KEY=your_weatherapi_key_here

# OpenWeatherMap Key (Free tier 1000 OneCall/day: https://home.openweathermap.org/users/sign_up)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Google Gemini API Key (For AI Flood Risk Insights & Citizen Bulletins: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Leaflet / Mapbox Public Token (Optional: https://account.mapbox.com/)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Prediction Thresholds
STORM_ALERT_THRESHOLD_MM_HR=35.0
CRITICAL_FLOOD_PROBABILITY_THRESHOLD=75.0
